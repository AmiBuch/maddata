# Anthropic (Claude) - for chatbot
ANTHROPIC_API_KEY=your_key_here

# AirNow (EPA AQI) - free at https://www.airnowapi.org/
AIRNOW_API_KEY=your_key_here

# NewsAPI - free at https://newsapi.org/
NEWS_API_KEY=your_key_here

# OpenWeatherMap - free at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here

# Google Pollen API (optional)
GOOGLE_API_KEY=your_key_here

# CORS origin for frontend
FRONTEND_URL=http://localhost:3000
