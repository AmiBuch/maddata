# Copy this file to .env.local and fill in your keys.
# NEXT_PUBLIC_ prefix means the variable is exposed to the browser bundle.

# Google Gemini API key — used client-side for PDF itinerary extraction.
# Get one at https://aistudio.google.com/app/apikey
# Update GEMINI_MODEL in page.tsx to "gemini-3-flash" (or the correct ID) once Gemini 3 is available.
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
